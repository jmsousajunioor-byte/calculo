RewriteEngine On
RewriteBase /

# Redirect to index.php when file/dir not found
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Only force HTTPS when explicitly enabled (e.g., production)
RewriteCond %{ENV:FORCE_HTTPS} =1
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
