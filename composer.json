{
    "name": "calcjudiciario/app",
    "description": "SaaS de cálculos judiciais com correção INPC e geração de PDF.",
    "type": "project",
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "pre-autoload-dump": [
            "php -r \"if(!is_dir('vendor/dompdf/dompdf/lib')){ @mkdir('vendor/dompdf/dompdf/lib', 0777, true); }\""
        ],
        "post-install-cmd": [
            "composer dump-autoload -o"
        ],
        "post-update-cmd": [
            "composer dump-autoload -o"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
